# Every text file is LF so goldens, fixtures and the vendor manifest's sha256
# verify under any core.autocrlf (the rules below stay as the explicit list).
* text=auto eol=lf

# Vendored upstream spec files MUST remain byte-identical to upstream so the
# sha256 checksums in vendor/observability-pack-spec/VERSIONS.json verify on
# every platform. Force LF regardless of core.autocrlf.
vendor/** text eol=lf

# Studio source files are LF too, by convention.
*.mjs   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Repository operation, not part of what a downstream copies: `git archive`,
# GitHub's source tarballs and `npm run vendor-export` leave these out
# (docs/DOWNSTREAM_REFRESH.md). The directory line keeps `git archive` from
# writing the folder at all; the `/**` line names its files for
# `git check-attr`, which the export reads.
/.github        export-ignore
/.github/**     export-ignore
/.claude        export-ignore
/.claude/**     export-ignore
/AGENTS.md      export-ignore
