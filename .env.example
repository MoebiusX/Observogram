# tools/fetch-live-pack.mjs — runtime config
#
# Copy to .env (local dev) or feed via your secret store / Kubernetes Secret
# in cluster.  Source with: `set -a; source .env; set +a; npm run fetch-live`.
#
# Every OBSERVOGRAM_* knob also honors its pre-rebrand TOMOGRAPH_* spelling
# (tools/lib/brand-env.mjs); the new name wins when both are set.

# MCP server endpoint (JSON-RPC 2.0 over Streamable HTTP).
#
# Local dev (in-process MCP from krystalinex-core):
#   MCP_URL=http://localhost:3100
# In-cluster authenticated MCP (recommended for production refreshes):
#   MCP_URL=http://krystalinex-otel-mcp-server:3001
# In-cluster public MCP (no auth; restricted tool set, expect sparser pack):
#   MCP_URL=http://krystalinex-mcp-public:3001
MCP_URL=http://localhost:3100

# Bearer token for the authenticated MCP. Leave empty for the public/local MCP.
# In krystalinex-core's Helm chart this is `.Values.otelMcpServer.auth.agentKey`
# rendered into the `<release>-mcp-auth` Secret as `auth-keys.json`.
MCP_AUTH=

# Output path (relative to repo root).
OUTPUT=examples/production-live.pack.yaml

# Per-request MCP timeout in milliseconds (default 30000, capped at 300000).
# OBSERVOGRAM_MCP_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Identity (docs/PRODUCTIZATION_PLAN.md Stage 1). Three postures:
#
#   STAND-ALONE USERS   — the DEFAULT: first boot with nothing configured
#                         seeds a default admin/admin (change asked at
#                         every sign-in until it lands, skippable per
#                         session; never valid beyond loopback).
#                         Manage accounts with:
#                           npm run users -- add alice --name "Alice"
#                         The session secret auto-generates into
#                         <workspace>/session-secret.
#   OPEN                — OBSERVOGRAM_AUTH=off: loopback, no login, no
#                         seeding — the pre-0.5 posture for dev shells/CI.
#   OIDC                — SSO against any OIDC provider (wins over the users
#                         file). Requires the issuer + client id + a shared
#                         session secret.

# 'off' disables identity entirely (open posture; beats OIDC + users file)
#OBSERVOGRAM_AUTH=off

# First-boot seed password for 'admin' — skips the forced change; for
# docker/k8s where the loopback first sign-in is impossible. Also
# replaces an admin record that still holds the seeded default (never a
# real password), so a loopback-seeded workspace can move to the network.
#OBSERVOGRAM_ADMIN_PASSWORD=

# Stand-alone users file (default: <workspace>/users.json)
#OBSERVOGRAM_USERS_FILE=.observogram/users.json

# OIDC single sign-on
#OBSERVOGRAM_OIDC_ISSUER=https://login.example.com/realms/main
#OBSERVOGRAM_OIDC_CLIENT_ID=observogram
#OBSERVOGRAM_OIDC_CLIENT_SECRET=            # omit for a public PKCE client
#OBSERVOGRAM_OIDC_REDIRECT_URL=https://observogram.example.com/auth/callback
#OBSERVOGRAM_SESSION_SECRET=                # >=32 chars; same on every instance
#OBSERVOGRAM_SESSION_TTL_HOURS=8

# Tenancy (Stage 2 — workspace-per-org). No env var: tenancy arms when
# <workspace>/orgs.json exists (manage with `npm run orgs`). Requires
# identity (users file or OIDC); each org's state lives under
# <workspace>/orgs/<orgId>/; an existing flat workspace migrates to
# orgs/default/ on first boot. Clients pick the org with the
# X-Observogram-Org header (default: the user's first membership).
#OBSERVOGRAM_OIDC_ALLOW_HTTP=               # '1' only for local test IdPs

# Service-account / CI access (works alongside either identity posture)
#OBSERVOGRAM_API_TOKEN=
#OBSERVOGRAM_API_TOKEN_LABEL=ci-bot

# Workspace root (journeys/, runs/, deploys.jsonl, users.json, packs/,
# observogram.db).
# Default: an existing .observogram/ (or pre-rebrand .tomograph/), else a
# fresh .observogram/. A scheduled journey (cron, schtasks, the k8s
# CronJob) MUST use the same root as the studio or its runs are never shown.
#OBSERVOGRAM_WORKSPACE=

# The embedded store (docs/STORE_PLAN.md): users, orgs, memberships and the
# audit, in one SQLite file per deployment on Node's built-in node:sqlite.
# Today only `packc store` opens it; the server does not read it yet
# (docs/STORE_PLAN.md §7). Set it now so the first build that does finds it.
# Default: <workspace>/observogram.db. It must sit on local disk: NFS, CIFS,
# SMB and CephFS are refused, FUSE is warned about (WAL needs shared memory
# between the processes on one host). ':memory:' is for in-process tests
# and throwaway demos only: it forgets everything at restart, and the
# `packc store` commands refuse it. To move a database, move the file (with
# nothing holding it open): it carries its store_id. Back it up live with
# `packc store backup <path>`, never by copying the file while anything has
# it open (README, "Back Up And Restore The Store").
#OBSERVOGRAM_DB=.observogram/observogram.db

# Run records kept per journey (oldest pruned after every run; 0 = unlimited).
#OBSERVOGRAM_JOURNEY_RUN_RETENTION=1000

# A journey's own env-var names — packB.mcp.authEnv, notify.urlEnv,
# notify.authEnv — are read literally (process.env[<name>]), not through the
# OBSERVOGRAM_/TOMOGRAPH_ fallback: set exactly the names the journey file
# declares, e.g.
#MY_MCP_TOKEN=
#MY_JOURNEY_WEBHOOK_URL=
#MY_JOURNEY_WEBHOOK_TOKEN=
