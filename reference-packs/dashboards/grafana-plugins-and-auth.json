      "description": "State of every symptom alert of the pack over the time range.",
      "targets": [
        {
          "refId": "A",
          "expr": "(2 * max by (alertname) (ALERTS{pack=\"grafana\", alertstate=\"firing\", burn_rate=\"\", kind=\"\"})) or max by (alertname) (ALERTS{pack=\"grafana\", alertstate=\"pending\", burn_rate=\"\", kind=\"\"}) or label_replace(vector(0), \"alertname\", \"no alert\", \"\", \"\")",
