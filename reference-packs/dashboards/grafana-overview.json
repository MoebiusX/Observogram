    {
      "id": 3,
      "type": "stat",
      "title": "Http request success",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Fraction of HTTP requests returning non-5xx responses. Excludes intentional 4xx (auth failures, validation errors) by treating only 5xx as the failure class. SLO 99.9 % over 30d.",
      "pack": {
        "binds_to": [
          "slis.http_request_success_ratio"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "grafana:http_request_success:ratio_5m",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F0616D",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 0.989
              },
              {
                "color": "#3DD68C",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
