    {
      "id": 11,
      "type": "state-timeline",
      "title": "Symptom alerts · pending / firing",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "description": "State of every symptom alert of the pack over the time range.",
      "targets": [
        {
          "refId": "A",
