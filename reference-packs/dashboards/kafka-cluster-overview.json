    {
      "id": 4,
      "type": "stat",
      "title": "Partition replica health",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "Fraction of partitions whose in-sync replica count equals their replica count. The comparison is `== bool` (1 per healthy partition): the filter form keeps the left-hand value, the ISR count, and sums to 3 x partitions on a healthy replication-factor-3 cluster (the burn generator always emitted the bool form; the pack's recording rule carried the filter form until 2026-09-22 — indistinguishable on the lab's replication factor 1). SLO 99.95 % over 30d.",
      "pack": {
        "binds_to": [
          "slis.partition_replica_health"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka:partition_health:ratio_5m",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F0616D",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 0.9945000000000006
              },
              {
                "color": "#3DD68C",
                "value": 0.9995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
