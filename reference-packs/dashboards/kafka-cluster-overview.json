    {
      "id": 6,
      "type": "stat",
      "title": "Fetch latency p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "99th-percentile local (broker processing) time of FetchConsumer requests, in seconds. LocalTimeMs, not TotalTimeMs: a consumer fetch's total time includes the long-poll wait (fetch.max.wait.ms, 500 ms by default) whenever the topic has nothing new, so TotalTimeMs p99 sits near 100 ms on an idle topic and would breach the 50 ms objective without any broker fault (measured). Same JMX-quantile shape as produce_latency_p99, milliseconds. SLO 99 % over 30d.",
      "pack": {
        "binds_to": [
          "slis.fetch_latency_p99"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka:fetch_latency:p99_5m)",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DD68C",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 0.05
              },
              {
                "color": "#F0616D",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
