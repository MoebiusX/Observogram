    {
      "id": 3,
      "type": "stat",
      "title": "Broker availability",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "Fraction of brokers reporting ready vs. cluster's declared broker count. SLO 99.9 % over 30d.",
      "pack": {
        "binds_to": [
          "slis.broker_availability"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka:broker_availability:ratio_5m",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F0616D",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 0.989
              },
              {
                "color": "#3DD68C",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
