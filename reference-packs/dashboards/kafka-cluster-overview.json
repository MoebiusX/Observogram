    {
      "id": 5,
      "type": "stat",
      "title": "Produce latency p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "99th-percentile total time of Produce requests on the broker (queue, local, remote/replication wait, response send), in seconds: what a producer waits for an ack. Kafka publishes its request-time histograms through JMX as per-quantile gauges (no _bucket series exist); with the Strimzi rule set the 0.99 quantile of kafka.network:type=RequestMetrics, name=TotalTimeMs is kafka_network_requestmetrics_totaltimems{quantile=\"0.99\"}, in milliseconds. SLO 99 % over 30d.",
      "pack": {
        "binds_to": [
          "slis.produce_latency_p99"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka:produce_latency:p99_5m)",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DD68C",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 0.1
              },
              {
                "color": "#F0616D",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
