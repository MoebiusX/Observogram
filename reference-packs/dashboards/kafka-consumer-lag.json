    {
      "id": 3,
      "type": "stat",
      "title": "Consumer group lag seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "Maximum consumer-group lag (in seconds equivalent), per critical consumer group. Computed by dividing message-count lag by the consumer's rolling consumption rate. SLO 99 % over 7d.",
      "pack": {
        "binds_to": [
          "slis.consumer_group_lag_seconds"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka:consumer_lag:seconds_max_5m)",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DD68C",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 60
              },
              {
                "color": "#F0616D",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      }
    },
