    {
      "id": 10,
      "type": "state-timeline",
      "title": "Burn-rate & forecast alerts · pending / firing",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "description": "Multi-window burn-rate alerts (fast windows page, slow windows linger after incidents) and forecasts.",
      "targets": [
        {
          "refId": "A",
          "expr": "(2 * max by (alertname) (ALERTS{pack=\"prometheus\", alertstate=\"firing\", burn_rate!=\"\"})) or max by (alertname) (ALERTS{pack=\"prometheus\", alertstate=\"pending\", burn_rate!=\"\"}) or label_replace(vector(0), \"alertname\", \"no alert\", \"\", \"\")",
          "legendFormat": "{{alertname}}"
        },
        {
          "refId": "B",
          "expr": "(2 * max by (alertname) (ALERTS{pack=\"prometheus\", alertstate=\"firing\", kind=\"forecast\"})) or max by (alertname) (ALERTS{pack=\"prometheus\", alertstate=\"pending\", kind=\"forecast\"})",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#4B5563"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "quiet",
                  "color": "#1E3A34"
                },
                "1": {
                  "text": "PENDING",
                  "color": "#F5B14C"
                },
                "2": {
                  "text": "FIRING",
                  "color": "#F0616D"
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 78
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.82,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
