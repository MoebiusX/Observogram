    {
      "id": 6,
      "type": "stat",
      "title": "Query latency p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "99th-percentile latency of the HTTP query API (/api/v1/query and /api/v1/query_range) from the server's own request-duration histogram prometheus_http_request_duration_seconds{handler}, buckets 0.1 .. 120 s (measured on 3.14.0; defined the same way at 2.55.1 per web/web.go). The histogram resolves nothing below its first bucket: a healthy server reads 0.099 s (0.99 x 0.1, every request in le=\"0.1\"), meaning \"p99 <= 0.1 s\"; the 1 s objective sits on the le=\"1.0\" bound, where the comparison is exact. The engine's prometheus_engine_query_duration_seconds is a summary (no _bucket series); the 3.x-only prometheus_engine_query_duration_histogram_seconds_bucket would give the engine-side view on 3.x alone. This is what a Grafana panel waits for. SLO 99 % over 30d. Good when ≤ 1 seconds.",
      "pack": {
        "binds_to": [
          "slis.query_latency_p99"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(prometheus:query_latency:p99_5m)",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DD68C",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 1
              },
              {
                "color": "#F0616D",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
