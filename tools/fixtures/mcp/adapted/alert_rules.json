  {
    "name": "NoTraffic",
    "expr": "sum(rate(http_requests_total[5m])) == 0\n",
    "for": "10m",
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "description": "No HTTP requests received in the last 10 minutes",
      "summary": "No traffic detected"
    },
    "health": "ok",
    "lastEvaluation": "2026-09-08T07:03:48.237535721Z",
    "evaluationTime": 0.001425293,
    "state": "inactive"
