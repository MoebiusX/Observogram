  {
    "name": "ColdWalletUnpricedFlows",
    "expr": "sum(increase(kx_cold_flow_unpriced_total[15m])) by (direction) > 0\n",
    "for": "1m",
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "description": "{{ $value }} cold-wallet {{ $labels.direction }} settlement(s) in the last 15 minutes could not be valued in USD (no price-service quote at settlement time) — kx_cold_flow_value_usd_total and the Business Activity USD tiles under-count until the price feed is back.",
      "runbook_url": "https://github.com/MoebiusX/krystalinex-core/blob/main/docs/observability/06_COLD_WALLET_ALERTS.md#coldwalletunpricedflows",
      "summary": "Cold-wallet {{ $labels.direction }} settled without a USD price"
    },
    "health": "ok",
    "lastEvaluation": "2026-09-08T07:03:52.21460519Z",
    "evaluationTime": 0.002001504,
    "state": "inactive"
  },
  {
    "name": "CustodyWebhookSignatureFailures",
    "expr": "sum(increase(kx_custody_webhook_events_total{outcome=\"invalid_signature\"}[10m])) >= 3\n",
    "for": "1m",
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "description": "{{ $value }} custody webhook calls were rejected with an invalid HMAC signature in the last 10 minutes — a probe against the endpoint, or a CUSTODY_WEBHOOK_SECRET mismatch after a deploy (the simulator self-POST falls back to direct delivery, so settlements may still be completing).",
      "runbook_url": "https://github.com/MoebiusX/krystalinex-core/blob/main/docs/observability/06_COLD_WALLET_ALERTS.md#custodywebhooksignaturefailures",
      "summary": "Custody webhook signature failures"
    },
    "health": "ok",
    "lastEvaluation": "2026-09-08T07:03:52.216637079Z",
    "evaluationTime": 0.001553573,
    "state": "inactive"
  },
  {
    "name": "CustodyWebhookSignatureFailures",
    "expr": "sum(increase(kx_custody_webhook_events_total{outcome=\"invalid_signature\"}[10m])) > 20\n",
    "for": "1m",
    "labels": {
      "severity": "critical"
    },
    "annotations": {
      "description": "{{ $value }} invalid-signature custody webhook calls in 10 minutes — sustained probing of the settlement webhook (or every settlement is being rejected because the shared secret is wrong).",
      "runbook_url": "https://github.com/MoebiusX/krystalinex-core/blob/main/docs/observability/06_COLD_WALLET_ALERTS.md#custodywebhooksignaturefailures",
      "summary": "Custody webhook under signature brute-force"
    },
    "health": "ok",
    "lastEvaluation": "2026-09-08T07:03:52.218222516Z",
    "evaluationTime": 0.001674042,
    "state": "inactive"
  },
  {
    "name": "CustodyWebhookErrors",
    "expr": "sum(increase(kx_custody_webhook_events_total{outcome=\"error\"}[10m])) by (provider, event_type) > 0\n",
    "for": "1m",
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "description": "{{ $value }} {{ $labels.event_type }} event(s) from provider {{ $labels.provider }} threw inside the settlement handler in the last 10 minutes — the hold or the deposit credit may be stuck; check the server error log and the withdrawal_requests / transactions rows referenced by the events.",
      "runbook_url": "https://github.com/MoebiusX/krystalinex-core/blob/main/docs/observability/06_COLD_WALLET_ALERTS.md#custodywebhookerrors",
      "summary": "Custody webhook settlement errors ({{ $labels.provider }}/{{ $labels.event_type }})"
    },
    "health": "ok",
    "lastEvaluation": "2026-09-08T07:03:52.219924116Z",
    "evaluationTime": 0.00154094,
    "state": "inactive"
  },
  {
    "name": "ColdWithdrawalStuckInFlight",
    "expr": "kx_cold_withdrawals_in_flight > 0\n",
    "for": "30m",
    "labels": {
      "severity": "critical"
    },
    "annotations": {
      "description": "{{ $value }} {{ $labels.asset }} cold withdrawal(s) have been queued/processing for more than 30 minutes (the demo settles in ~30 s) — customer funds are on hold with no settlement event arriving; the chain simulator or the custodian callback path is not delivering.",
      "runbook_url": "https://github.com/MoebiusX/krystalinex-core/blob/main/docs/observability/06_COLD_WALLET_ALERTS.md#coldwithdrawalstuckinflight",
      "summary": "{{ $labels.asset }} cold withdrawals stuck in flight"
    },
    "health": "ok",
    "lastEvaluation": "2026-09-08T07:03:52.221491988Z",
    "evaluationTime": 0.001383465,
    "state": "inactive"
  },
  {
    "name": "ColdWithdrawalSettlementSlow",
    "expr": "(\n  histogram_quantile(0.95,\n    sum(rate(kx_cold_withdrawal_settlement_seconds_bucket[30m])) by (le)\n  ) > 90\n)\nand\n(\n  sum(rate(kx_cold_withdrawal_settlement_seconds_count[30m])) > 0\n)\n",
    "for": "5m",
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "description": "p95 request-to-confirmed settlement latency over the last 30 minutes is {{ $value | humanizeDuration }} (threshold: 90 s; the demo design is ~30 s). A value of exactly 120 s means the p95 fell beyond the histogram's last bucket.",
      "runbook_url": "https://github.com/MoebiusX/krystalinex-core/blob/main/docs/observability/06_COLD_WALLET_ALERTS.md#coldwithdrawalsettlementslow",
      "summary": "Cold withdrawal settlement is slow (p95 over 30m)"
    },
    "health": "ok",
    "lastEvaluation": "2026-09-08T07:03:52.222901959Z",
    "evaluationTime": 0.001258226,
    "state": "inactive"
  },
