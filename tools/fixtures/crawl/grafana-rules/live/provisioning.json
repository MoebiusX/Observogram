[
  {
    "id": 1,
    "uid": "checkout-errors",
    "orgID": 1,
    "folderUID": "shop-alerts",
    "ruleGroup": "shop",
    "title": "CheckoutErrorRatioHigh",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "datasourceUid": "prom",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "model": {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"checkout\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"checkout\"}[5m]))",
          "instant": true
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0.05
                ]
              }
            }
          ]
        }
      }
    ],
    "for": "5m",
    "labels": {
      "severity": "critical",
      "team": "shop"
    },
    "annotations": {
      "summary": "Checkout errors above 5%"
    },
    "noDataState": "NoData",
    "execErrState": "Error",
    "isPaused": false,
    "record": null
  },
  {
    "id": 2,
    "uid": "payments-latency",
    "orgID": 1,
    "folderUID": "shop-alerts",
    "ruleGroup": "shop",
    "title": "PaymentsLatencyHigh",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "datasourceUid": "prom",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "model": {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"payments\"}[5m])))",
          "instant": true
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0.8
                ]
              }
            }
          ]
        }
      }
    ],
    "for": "10m",
    "labels": {
      "severity": "warning",
      "team": "shop"
    },
    "noDataState": "NoData",
    "execErrState": "Error",
    "isPaused": false,
    "record": null
  },
  {
    "id": 3,
    "uid": "cart-restarts",
