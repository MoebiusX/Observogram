        {
          "refId": "A",
          "expr": "(2 * max by (alertname) (ALERTS{pack=\"payment-service\", alertstate=\"firing\", burn_rate=\"\", kind=\"\"})) or max by (alertname) (ALERTS{pack=\"payment-service\", alertstate=\"pending\", burn_rate=\"\", kind=\"\"}) or label_replace(vector(0), \"alertname\", \"no alert\", \"\", \"\")",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#4B5563"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "quiet",
                  "color": "#1E3A34"
                },
                "1": {
                  "text": "PENDING",
                  "color": "#F5B14C"
                },
                "2": {
                  "text": "FIRING",
                  "color": "#F0616D"
                }
