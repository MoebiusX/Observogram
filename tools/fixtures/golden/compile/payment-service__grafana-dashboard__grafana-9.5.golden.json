    {
      "id": 3,
      "type": "stat",
      "title": "Api availability",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "HTTP responses that are not 5xx, over total responses. SLO 99.9 % over 30d.",
      "pack": {
        "binds_to": [
          "slis.api_availability"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "payment:api_availability:ratio_5m",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F0616D",
                "value": null
              },
              {
                "color": "#F5B14C",
                "value": 0.989
              },
              {
                "color": "#3DD68C",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      }
    },
    {
