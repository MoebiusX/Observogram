        {
          "refId": "A",
          "expr": "(2 * max by (alertname) (ALERTS{pack=\"edge-hostile-names\", alertstate=\"firing\", burn_rate=\"\", kind=\"\"})) or max by (alertname) (ALERTS{pack=\"edge-hostile-names\", alertstate=\"pending\", burn_rate=\"\", kind=\"\"}) or label_replace(vector(0), \"alertname\", \"no alert\", \"\", \"\")",
          "legendFormat": "{{alertname}}"
