    "slis": [
      {
        "id": "finops_cpu",
        "description": "Inferred from recording rule finops:cpu:usage_per_pod_5m.",
        "type": "threshold",
        "query": "sum(rate(container_cpu_usage_seconds_total{namespace=\"krystalinex\", container!=\"\"}[5m])) by (pod) * 3600\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "finops_memory",
        "description": "Inferred from recording rule finops:memory:usage_per_pod_gb_hours.",
        "type": "threshold",
        "query": "sum(container_memory_working_set_bytes{namespace=\"krystalinex\", container!=\"\"}) by (pod) / 1073741824\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "finops_kong",
        "description": "Inferred from recording rule finops:kong:overhead_seconds.",
        "type": "threshold",
        "query": "histogram_quantile(0.99,\n  sum(rate(kong_kong_latency_ms_bucket[5m])) by (le)\n) / 1000\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "finops_requests",
        "description": "Inferred from recording rule finops:requests:rate_per_service_5m.",
        "type": "threshold",
        "query": "sum(rate(http_requests_total[5m])) by (job)\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "finops_errors",
        "description": "Inferred from recording rule finops:errors:rate_per_service_5m.",
        "type": "threshold",
        "query": "sum(rate(http_request_errors_total[5m])) by (job)\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "finops_spans",
        "description": "Inferred from recording rule finops:spans:dropped_rate_5m.",
        "type": "threshold",
        "query": "sum(rate(otelcol_processor_dropped_spans_total[5m]))\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "finops_logs",
        "description": "Inferred from recording rule finops:logs:bytes_rate_per_component_5m.",
        "type": "threshold",
        "query": "sum(rate(promtail_read_bytes_total[5m])) by (filename)\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "genai_client_operation_duration",
        "description": "Inferred from recording rule genai:client_operation_duration:p95_5m.",
        "type": "threshold",
        "query": "histogram_quantile(\n  0.95,\n  sum(rate(gen_ai_client_operation_duration_seconds_bucket[5m]))\n    by (le, provider, model, operation)\n)\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "genai_client_operation",
        "description": "Inferred from recording rule genai:client_operation:error_ratio_5m.",
        "type": "ratio",
        "good": "sum(rate(gen_ai_client_operations_total{status=~\"error|timeout\"}[5m]))\n  by (provider, model, operation)\n/\nclamp_min(\n  sum(rate(gen_ai_client_operations_total[5m]))\n    by (provider, model, operation),\n  0.000001\n)\n",
        "total": "1"
      },
      {
        "id": "genai_client_token_usage",
        "description": "Inferred from recording rule genai:client_token_usage:rate_1h.",
        "type": "threshold",
        "query": "sum(rate(gen_ai_client_token_usage_sum[1h]))\n  by (model, direction)\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "genai_rca_analysis_duration",
        "description": "Inferred from recording rule genai:rca_analysis_duration:p95_5m.",
        "type": "threshold",
        "query": "histogram_quantile(\n  0.95,\n  sum(rate(kx_llm_analysis_duration_seconds_bucket[5m])) by (le)\n)\n",
        "threshold": 1,
        "unit": "ratio"
      },
      {
        "id": "genai_rca_analysis",
        "description": "Inferred from recording rule genai:rca_analysis:failure_ratio_5m.",
        "type": "threshold",
        "query": "sum(rate(kx_llm_analysis_total{status=~\"failure|timeout\"}[5m]))\n  by (use_case)\n/\nclamp_min(\n  sum(rate(kx_llm_analysis_total[5m])) by (use_case),\n  0.000001\n)\n",
        "threshold": 1,
        "unit": "ratio"
      }
    ],
    "slos": [
      {
        "id": "finops_cpu_99",
        "sli": "finops_cpu",
        "objective": 0.99,
        "window": "30d",
        "error_budget_policy": "ref:platform/default-budget"
